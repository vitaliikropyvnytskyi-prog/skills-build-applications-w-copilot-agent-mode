{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "rootDir": "./src",
    "outDir": "dist",
    "baseUrl": "./",
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["src"]
}
